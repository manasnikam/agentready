# ---- Cloudflare deployment ----
# No env vars needed at runtime: telemetry uses the D1 binding "DB" from
# wrangler.jsonc. Without a binding (plain `next dev`), an in-memory fallback
# is used automatically.

# ---- Runner (executes on your machine, never deployed) ----
# Cloudflare Workers AI (recommended — whole stack stays on Cloudflare):
# OPENAI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# OPENAI_API_KEY=<cloudflare api token with Workers AI permission>
# RUNNER_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
#
# Or any other OpenAI-compatible endpoint:
# OPENAI_API_KEY=sk-...
# RUNNER_MODEL=gpt-4o-mini

# Browser backend for the runner — Cloudflare Browser Run (recommended):
# CF_ACCOUNT_ID=<account id>
# CF_API_TOKEN=<api token with Browser Rendering Edit permission>
