{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentready",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": { "directory": "dist/client", "not_found_handling": "none", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "cache": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "images": { "binding": "IMAGES" },
  "kv_namespaces": [
    // npx wrangler kv namespace create VINEXT_KV_CACHE → paste the id:
    { "binding": "VINEXT_KV_CACHE", "id": "dfcf20f5f0e14bec84d0e1146c4ab284" }
  ],
  "queues": {
    "producers": [
      // npx wrangler queues create agentready-audits
      { "binding": "AUDIT_QUEUE", "queue": "agentready-audits" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentready-telemetry",
      // npx wrangler d1 create agentready-telemetry → paste the id:
      "database_id": "66fe5f89-31d3-46e4-b69a-f91b8143b730"
    }
  ]
  // Post-hackathon: add an R2 bucket for runner screenshots/artifacts:
  // "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "agentready-artifacts" }]
}
